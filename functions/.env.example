# Non-secret runtime configuration copied to functions/.env.
# Do not use FIREBASE_* names; Firebase reserves that prefix.
BOT_USERNAME=your_bot_username

# Firebase supplies these automatically after deployment. Set them only when
# local tooling cannot discover your project configuration.
# DATABASE_URL=https://your-project-default-rtdb.firebaseio.com/
# STORAGE_BUCKET=your-project.firebasestorage.app
